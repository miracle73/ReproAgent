// Resource override for hosts smaller than the nf-core test profiles assume.
//
// nf-core declares generous labels (up to 24 CPUs / 200 GB) and Nextflow
// refuses to submit a task whose requirement exceeds the executor's declared
// resources, so on a small host the process labels, the withName selectors and
// the executor declaration all have to be lowered together or the run aborts
// with e.g.
//   "Process requirement exceeds available memory -- req: 12 GB; avail: 5.7 GB"
//   "Process requirement exceeds available CPUs -- req: 4; avail: 2"
//
// Pass it with `reproagent run --config configs/constrained-host.config`.
// ReproAgent copies it into the run bundle and records its SHA-256 in the
// manifest, so a replay reproduces the same launch without this file.
//
// Only resource offers change; no scientific parameter is touched, so outputs
// stay comparable with a run on a bigger host. Measured on a 4-vCPU laptop with
// Docker Desktop exposing 4 CPUs / 5.7 GB.
//
// The withLabel entries are generic nf-core labels. The withName entries mirror
// the selectors in nf-core/sarek 3.5.1 conf/base.config; extend that block for
// other pipelines.
process {
    resourceLimits = [ cpus: 4, memory: '4.GB', time: '4.h' ]

    withLabel: process_single {
        cpus   = 1
        memory = 2.GB
    }
    withLabel: process_low {
        cpus   = 2
        memory = 3.GB
    }
    withLabel: process_medium {
        cpus   = 2
        memory = 4.GB
    }
    withLabel: process_high {
        cpus   = 2
        memory = 4.GB
    }
    withLabel: process_high_memory {
        memory = 4.GB
    }
    withLabel: process_long {
        time = 20.h
    }

    withName: 'BWAMEM1_MEM|BWAMEM2_MEM' {
        cpus   = 2
        memory = 4.GB
    }
    withName: 'FASTP' {
        cpus   = 2
        memory = 4.GB
    }
    withName: 'FASTQC' {
        cpus   = 2
        memory = 4.GB
    }
    withName: 'STRELKA.*|MANTA.*' {
        cpus   = 2
        memory = 4.GB
    }
    withName: 'MULTIQC' {
        cpus   = 1
        memory = 2.GB
    }
    withName: 'GATK4_MARKDUPLICATES|GATK4SPARK_MARKDUPLICATES' {
        cpus   = 2
        memory = 4.GB
    }
}

executor {
    $local {
        cpus   = 4
        memory = 4.GB
    }
}